        "/api/orders/sync": {
            "post": {
                "tags": [
                    "Sync"
                ],
                "summary": "Kirim batch transaksi dari kasir app (offline sync)",
                "description": "Endpoint idempotent — jika `id` (UUID) transaksi sudah pernah diterima sebelumnya, server mengabaikan duplikat dan mengembalikan status 'already_synced' tanpa membuat data baru.",
                "operationId": "5107759aeaba1e5ad3225a4e22c2b6f4",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "orders": {
                                        "type": "array",
                                        "items": {
                                            "$ref": "#/components/schemas/OrderSyncPayload"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Batch processed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "string",
                                                        "format": "uuid"
                                                    },
                                                    "status": {
                                                        "type": "string",
                                                        "enum": [
                                                            "synced",
                                                            "already_synced",
                                                            "conflict",
                                                            "rejected"
                                                        ]
                                                    },
                                                    "reason": {
                                                        "type": "string",
                                                        "nullable": true
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
