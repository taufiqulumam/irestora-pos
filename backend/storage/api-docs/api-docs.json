        "/api/tables/{tableId}/close": {
            "post": {
                "tags": [
                    "Tables"
                ],
                "summary": "Tutup meja secara manual (kasir) - meja kembali berstatus available",
                "description": "Hanya bisa dilakukan jika order aktif di meja tsb sudah berstatus paid. Bisa dilakukan kasir manapun yang sedang shift aktif di outlet tersebut (tidak harus kasir yang membuka order). Aksi ini tercatat di audit_logs.",
                "operationId": "cc87338b67843733670b1c3fffa7eb63",
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "reason": {
                                        "description": "Catatan opsional, misal 'meja sudah dibersihkan'",
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Meja kembali berstatus available"
                    },
                    "404": {
                        "description": "Meja tidak ditemukan"
                    },
                    "422": {
                        "description": "Meja tidak punya order aktif, atau order belum lunas (status bukan paid)"
                    },
                    "409": {
                        "description": "Anda belum membuka shift"
                    }
                },
                "security": [
                    {
